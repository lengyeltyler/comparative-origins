{
  "name": "comparative-origins",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run validate && npm run generate && npm run typecheck && npm run build:static",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib scripts tests site/main.tsx site/vite.config.ts",
    "format": "oxfmt",
    "predev": "npm run generate",
    "build:worker": "vinext build",
    "build:static": "vite build --config site/vite.config.ts",
    "preview:static": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "validate": "node scripts/validate-data.mjs",
    "generate": "node scripts/build-comparisons.mjs && node scripts/generate-timeline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "lint:starter": "oxlint components hooks",
    "test:render": "node scripts/test-render.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "8.18.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "^0.35.4"
  }
}
