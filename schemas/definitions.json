{
  "$id": "https://comparative-origins.example/schema/definitions",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "locator"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "primary-evidence",
            "textual-reconstruction",
            "historical-interpretation",
            "traditional-interpretation",
            "speculation"
          ]
        },
        "confidence": {
          "enum": [
            "very-high",
            "high",
            "moderate",
            "low",
            "speculative",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "documented",
            "todo",
            "fragmentary"
          ]
        },
        "label": {
          "enum": [
            "PRIMARY SOURCE",
            "SCHOLARLY INTERPRETATION",
            "SCHOLARLY CONSENSUS",
            "MAJORITY VIEW",
            "DISPUTED",
            "MINORITY VIEW",
            "SPECULATION",
            "UNKNOWN",
            "TRADITIONAL INTERPRETATION"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 0
        }
      },
      "required": [
        "text",
        "category",
        "confidence",
        "status",
        "label",
        "citations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "todo"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "pattern": "^TODO:"
              },
              "confidence": {
                "const": "unknown"
              },
              "label": {
                "const": "UNKNOWN"
              }
            }
          },
          "else": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "end": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "documented",
            "todo"
          ]
        },
        "scope": {
          "enum": [
            "composition",
            "individual-witness",
            "earliest-witness",
            "corpus-context"
          ]
        },
        "confidence": {
          "enum": [
            "very-high",
            "high",
            "moderate",
            "low",
            "speculative",
            "unknown"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 0
        }
      },
      "required": [
        "label",
        "start",
        "end",
        "status",
        "scope",
        "confidence",
        "citations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "todo"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "pattern": "^TODO:"
              },
              "start": {
                "type": "null"
              },
              "end": {
                "type": "null"
              },
              "confidence": {
                "const": "unknown"
              }
            }
          },
          "else": {
            "properties": {
              "citations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
